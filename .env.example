# =============================================================================
# POLIDOC — variables de entorno
# Copia este archivo a `.env` y completa los valores. NUNCA subas `.env` al repo.
# =============================================================================

# --- Django ---
SECRET_KEY=cambia-esto-por-una-clave-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
PORT=8001
TERMINOS_VERSION=1.0

# --- Base de datos relacional ---
# Django admite SQLite (por defecto) o PostgreSQL.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db_new.sqlite3
# Para PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=polidoc
# DB_HOST=db
# DB_PORT=5432
# DB_USER=polidoc
# DB_PASSWORD=cambia-esto

# --- MongoDB (logs de auditoría ISO) ---
MONGO_URI=mongodb://admin:admin@mongodb:27017/?authSource=admin
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=polidoc_audit_logs
MONGO_USER=admin
MONGO_PASSWORD=cambia-esto

# --- Celery (broker RabbitMQ / backend Redis) ---
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1

# --- Email (Mailpit en desarrollo) ---
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=polidoc@example.com

# --- LDAP / Active Directory ---
AUTH_LDAP_SERVER_URI=ldap://ldap.example.local:389
AUTH_LDAP_BASE_DN=dc=example,dc=local
AUTH_LDAP_BIND_DN=cn=svc-polidoc,cn=users,dc=example,dc=local
AUTH_LDAP_BIND_PASSWORD=cambia-esto
AUTH_LDAP_GROUP_BASE_DN=ou=groups,dc=example,dc=local

# --- Resumen IA (Google Gemini) ---
IA_RESUMEN_HABILITADO=False
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_FALLBACK=gemini-1.5-flash
IA_RESUMEN_LIMITE_DIARIO=20
IA_RESUMEN_MAX_MB=15
IA_RESUMEN_MAX_TOKENS=4096
IA_RESUMEN_REINTENTOS=2
IA_RESUMEN_TIMEOUT_MIN=5
IA_RESUMEN_SINCRONO=False

# --- Auditoría / ISO ---
AUDIT_HMAC_KEY=
AUDIT_FAIL_CLOSED=False
AUDIT_TRUSTED_PROXIES=127.0.0.1
AUDIT_MONGO_DOWN_SEGUNDOS=60

# --- Documentos / PDF ---
DOCUMENTOS_MAX_UPLOAD_MB=25
PAPEL_PDF_CONVERSION=A4
PDF_QA_ADAPTATIVO=True
PDF_QA_TEXTO_SOLAPE=True
PDF_REPARAR_EN_CELERY=True
PDF_MAX_INTENTOS=3
PDF_SALTO_DOCX=True

# --- Descargas / aprobaciones ---
DESCARGA_VIGENCIA_DIAS=30
APROBACION_ESCALADO_HORAS=48
APROBACION_EVALUADOR_DEPTO_GG=SGC
PLANILLAS_BARRIDO_MINUTOS=15
PLANILLAS_BARRIDO_LOTE=100

# --- Estáticos (django-compressor) ---
# En DEBUG se autodetecta; fija aquí solo si necesitas forzarlo.
# COMPRESS_ENABLED=True
# COMPRESS_OFFLINE=True
